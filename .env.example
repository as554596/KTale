# 環境變量配置（可選）

# DeepSeek API 配置
DEEPSEEK_API_KEY=your_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 或使用其他 OpenAI 兼容的 API
# OPENAI_API_KEY=your_key
# OPENAI_BASE_URL=https://api.openai.com/v1

# 服務配置
FLASK_ENV=production
FLASK_HOST=0.0.0.0
FLASK_PORT=5000

# 文件上傳限制（MB）
MAX_FILE_SIZE=50

# 並發處理配置
MAX_WORKERS=3
BATCH_SIZE=10
